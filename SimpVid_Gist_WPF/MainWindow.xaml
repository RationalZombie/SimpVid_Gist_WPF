<Window x:Class="SimpVid_Gist_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpVid_Gist_WPF"
        mc:Ignorable="d" WindowStyle="None"
        Title="SimpVid Gist"
        Height="750" Width="450"
        MaxHeight="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenHeight}}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,5,0,5" VerticalAlignment="Center">
            <TextBlock Margin="16,0,0,0" FontSize="24" TextWrapping="Wrap" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center">SimpVid Gist</TextBlock>
            <TextBlock Margin="4,0,0,0" Foreground="Gray" FontSize="14" TextWrapping="Wrap" DockPanel.Dock="Left" VerticalAlignment="Bottom">v1.4</TextBlock>
            <Button Margin="0,0,10,0" FontSize="12" Name="Button_Close" Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right" Height="30" Click="Button_Close_Click" Background="#FE6584"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Width="50"
                                CornerRadius="15"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF4C70"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="DarkRed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Background="#FFA500" ToolTip="Minimize"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                Margin="0,0,10,0" Name="Button_Minimize" Content="-" DockPanel.Dock="Right" HorizontalAlignment="Right" Height="30" Click="Button_Minimize_Click" FontWeight="Bold" FontSize="30">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Width="30"
                                CornerRadius="15"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#CC8400"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#996300"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Background="LightSeaGreen" FontSize="12"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                Margin="0,0,10,0" Name="Button_Save" Content="Export" DockPanel.Dock="Right" HorizontalAlignment="Right" Height="30" Click="Button_Save_Click" Cursor="Arrow">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Width="50"
                                CornerRadius="15"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="SeaGreen"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="DarkOliveGreen"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <StackPanel Margin="16">
                <TextBlock Margin="0,0,0,20" TextWrapping="Wrap" Foreground="Gray">
                    Extract and summarize YouTube video transcripts. 
                </TextBlock>

                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" FontWeight="SemiBold">Video URL or ID</TextBlock>
                <TextBox Name="UrlTextBox" TextWrapping="Wrap"/>
                <TextBlock Margin="0,15,0,0" FontWeight="SemiBold">Subtitle Language</TextBlock>
                <ComboBox Name="LanguageCodeComboBox" SelectedIndex="0" Margin="0,10,0,0">
                    <ComboBoxItem Content="English (en)" Tag="en"/>
                    <ComboBoxItem Content="Simplified Chinese (zh-Hans)" Tag="zh-Hans"/>
                    <ComboBoxItem Content="Traitional Chinese (zh-Hant)" Tag="zh-Hant"/>
                    <ComboBoxItem Content="Japanese (ja)" Tag="ja"/>
                    <ComboBoxItem Content="Korean (ko)" Tag="ko"/>
                    <ComboBoxItem Content="Spainish (es)" Tag="es"/>
                    <ComboBoxItem Content="French (fr)" Tag="fr"/>
                    <ComboBoxItem Content="Russian (ru)" Tag="ru"/>
                </ComboBox>

                <Button Background="SkyBlue" x:Name="ExtractButton" Margin="0,10,0,10" Click="ExtractButton_Click" HorizontalAlignment="Center">
                    Extract Transcript
                </Button>

                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" FontWeight="SemiBold">Transcript</TextBlock>
                <TextBox x:Name="TranscriptTextBox" TextWrapping="Wrap" MinHeight="100" MaxHeight="200" IsReadOnly="True" AcceptsReturn="True"/>

                <TextBlock Margin="0,20,0,20" TextWrapping="Wrap" Foreground="Gray">
                    Provide an API key to also generate a summary.
                </TextBlock>
                <StackPanel>

                    <TextBlock Margin="0,0,0,5" TextWrapping="Wrap" FontWeight="SemiBold">AI Base URL (API Endpoint)</TextBlock>
                    <TextBox Name="BaseUrlTextBox" TextWrapping="Wrap"/>

                    <TextBlock Margin="0,10,0,5" TextWrapping="Wrap" FontWeight="SemiBold">Model Name</TextBlock>
                    <TextBox Name="ModelTextBox" TextWrapping="Wrap"/>

                    <TextBlock Margin="0,10,0,5" TextWrapping="Wrap" FontWeight="SemiBold">AI API key</TextBlock>
                    <PasswordBox Name="ApiKeyTextBox" PasswordChar="*"/>

                    <Button x:Name="SaveButton" Margin="0,20,0,0" HorizontalAlignment="Center" Click="SaveButton_Click">Save AI Base URL and Model Name</Button>

                    <Button Background="Violet" x:Name="SummarizeButton" Margin="0,10,0,20" Click="SummarizeButton_Click" IsEnabled="False" HorizontalAlignment="Center">
                        Summarize Transcript
                    </Button>
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" FontWeight="SemiBold">Summary</TextBlock>

                    <TextBox x:Name="SummaryTextBox" TextWrapping="Wrap" MinHeight="100" IsReadOnly="True" AcceptsReturn="True"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>